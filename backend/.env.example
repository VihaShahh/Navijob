DJANGO_SECRET_KEY=replace-with-a-private-random-secret-of-at-least-50-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Preview settings always override DATABASE_URL with isolated SQLite.
DATABASE_URL=sqlite:///db.sqlite3
FRONTEND_URL=http://localhost:3100
CSRF_TRUSTED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
CORS_ALLOWED_ORIGINS=http://localhost:3100
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=NaviJob <preview@example.test>
# PRIVATE_UPLOAD_ROOT=/absolute/private/storage/path
